<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Official artist link hub for Dønjay Alpha">
<title>Dønjay Alpha — Official Artist Links</title>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
    color: #fff;
    background:
      radial-gradient(circle at 50% 0%, #333 0%, #111 38%, #050505 75%);
    display: flex;
    justify-content: center;
    padding: 28px 16px;
  }

  .wrap {
    width: 100%;
    max-width: 520px;
    text-align: center;
  }

  .avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    margin: 8px auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, #fff, #777, #111);
    color: #050505;
    font-size: 28px;
    font-weight: 900;
    border: 3px solid #fff;
    box-shadow: 0 0 35px rgba(255,255,255,.18);
  }

  h1 {
    font-size: 31px;
    letter-spacing: -1px;
  }

  .handle {
    color: #aaa;
    margin-top: 6px;
  }

  .bio {
    font-size: 14px;
    color: #ccc;
    line-height: 1.5;
    margin: 14px auto 22px;
    max-width: 420px;
  }

  .links {
    display: grid;
    gap: 13px;
  }

  .link {
    display: block;
    text-decoration: none;
    color: #fff;
    background: #171717;
    border: 1px solid #333;
    border-radius: 16px;
    padding: 17px 20px;
    font-weight: 700;
    transition: .2s;
    box-shadow: 0 7px 20px rgba(0,0,0,.25);
  }

  .link:hover {
    transform: translateY(-2px);
    background: #222;
    border-color: #666;
  }

  .featured {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  .featured:hover {
    background: #eee;
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 24px 0;
  }

  .socials a {
    width: 44px;
    height: 44px;
    border: 1px solid #333;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    text-decoration: none;
    background: #111;
    font-weight: bold;
  }

  footer {
    color: #777;
    font-size: 12px;
    margin-top: 20px;
  }

  .tag {
    display: inline-block;
    margin-top: 4px;
    color: #fff;
    font-size: 11px;
    border: 1px solid #444;
    padding: 4px 8px;
    border-radius: 999px;
  }
</style>
</head>

